# Application
APP_NAME="Shares Manager"
SECRET_KEY="change-me-to-a-long-random-string"
DEBUG=true

# Database. SQLite for dev; PostgreSQL for prod, e.g.
#   postgresql+psycopg://user:pass@localhost:5432/shares
DATABASE_URL="sqlite:///./shares.db"

# Create tables on startup (dev convenience). Set false in production and let
# Alembic migrations manage the schema (the Docker entrypoint runs them).
AUTO_CREATE_TABLES=true

# Initial admin user created by the seed script
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Where generated certificate PDFs are stored
ARTIFACTS_DIR="./artifacts"
